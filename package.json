{
  "name": "team-riley-tasks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "migrate": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; tsx packages/db/src/cli-migrate.ts'",
    "slack": "tsx apps/slack/src/index.ts",
    "api": "tsx apps/api/src/index.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "sync-channels": "tsx scripts/sync-channel-map.ts",
    "prune-interactions": "tsx scripts/prune.ts",
    "import-tasks": "tsx scripts/import-tasks.ts",
    "scheduled": "tsx scripts/run-scheduled.ts",
    "web": "sh -c 'set -a; . ./.env; set +a; pnpm --filter @tr/web dev'",
    "web:build": "sh -c 'set -a; . ./.env; set +a; pnpm --filter @tr/web build'"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "dotenv": "^16.6.1",
    "@tr/db": "workspace:*",
    "@tr/task-core": "workspace:*",
    "@tr/slack-ui": "workspace:*",
    "@tr/importer": "workspace:*",
    "@tr/scheduler": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
