# Slack — new dedicated app, Socket Mode
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=

# Authorization: comma-separated Slack user IDs. Empty = any member of SLACK_TEAM_ID.
AUTHORIZED_SLACK_USER_IDS=

# Default assignee
DEFAULT_ASSIGNEE_SLACK_ID=
DEFAULT_ASSIGNEE_LABEL=
# Everyone who can be assigned a task, as id=Name pairs:
#   ASSIGNEE_LABELS=U0BU0V0850Q=Joshua,U0BT6HDBYBC=Rachael
# A Slack id is unreadable, so every surface shows the name and stores the id.
# The pair above still names the DEFAULT assignee; this names the whole list.
ASSIGNEE_LABELS=

# Database.
# The Slack app, API and MCP server accept: empty (in-memory PGlite),
# file://./.pglite (local persistence), or a postgres:// URL.
# The web app requires a postgres:// URL — PGlite cannot run inside the
# bundled Next server. Use the Supabase transaction-mode pooler (port 6543).
DATABASE_URL=

# Deterministic relative due-date resolution
DEFAULT_TIMEZONE=America/Chicago

# REST API
API_PORT=3030
API_TOKEN=

# Slack transport: socket | http
SLACK_MODE=socket
PORT=3000

# Channel -> Space mapping config consumed by `pnpm sync-channels`
CHANNEL_MAP_PATH=config/channel-map.json

# How long Slack interaction dedupe rows are retained (days, default 7).
# Only needs to outlive Slack's retry window, which is seconds.
INTERACTION_RETENTION_DAYS=7

# --- Scheduled Slack posts (packages/scheduler) ---
# The weekly task briefings, Mondays 13:00 UTC. No AI involved. Every other
# recurring schedule (EOS, finance reports, analysis) belongs to Hermes.
# Client and Finance briefings need no variable here: each goes to the channel
# its Space is mapped to with /space or /map. See SCHEDULED.md.
#
# Where the Agency briefing goes (#agency-ops). Unset = that post is skipped
# and logged rather than failing, which cannot stop any other briefing.
SCHEDULED_AGENCY_CHANNEL_ID=
# Where the Personal briefing goes (#personal-ops). Invite the bot first.
SCHEDULED_PERSONAL_CHANNEL_ID=
# Spaces in the Agency briefing, by slug or name; Inbox is always included.
# Comma-separated. Default: agency-internal,marketing,sales
SCHEDULED_AGENCY_SPACES=
# Spaces in the Personal briefing. Default: personal,music,spiritual
SCHEDULED_PERSONAL_SPACES=
# Tasks shown per Space, highest priority first; the rest are counted.
# Default: 10
SCHEDULED_TOP_PER_SPACE=
# Authorizes the cron endpoint. Vercel sends it as a bearer token on its own
# cron invocations; the same value authorizes a manual trigger.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Remote MCP for Hermes (packages/mcp over HTTPS)
# Bearer token for https://<host>/mcp. Separate from API_TOKEN on purpose, so
# MCP access can be revoked without taking the REST API down.
# Generate with `openssl rand -hex 32`. Unset = the endpoint denies everything.
TASKS_MCP_TOKEN=

# Connector sign-in for Claude.ai / ChatGPT (docs/specs/connector-oauth.md).
# Signs the OAuth tokens; at least 32 characters. Unset (or shorter) = the
# sign-in is off and /mcp accepts only TASKS_MCP_TOKEN. Rotating it signs every
# connector out. Generate with `openssl rand -hex 32`.
MCP_OAUTH_SECRET=

# --- Web UI (apps/web) ---
# Auth.js. Names are fixed by Auth.js and cannot be renamed.
# AUTH_SECRET: generate with `openssl rand -base64 32`.
# AUTH_SLACK_ID / AUTH_SLACK_SECRET: from the Slack app's OAuth settings.
AUTH_SECRET=
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=

# Local sign-in bypass. A Slack user ID, e.g. U01ABCDEF.
# Slack requires an https OAuth redirect even on localhost, so this stands in
# during development. Ignored entirely when NODE_ENV=production.
WEB_DEV_USER=
