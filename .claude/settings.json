{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/renovate-prs",
            "timeout": 6,
            "statusMessage": "Checking Renovate PRs"
          }
        ]
      }
    ]
  }
}
